{
  "name": "swiss-nav-web",
  "version": "0.1.0",
  "private": true,
  "description": "Swiss Admin Navigator web UI + BFF (M6). Unofficial. Not legal advice.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@google-cloud/firestore": "9.3.1",
    "google-auth-library": "11.1.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
