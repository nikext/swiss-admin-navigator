# Copy to .env (gitignored). See docs/GCP.md.

# --- GCP ---
GOOGLE_CLOUD_PROJECT=           # agreed project: see CLAUDE.md
# Infra region (Agent Runtime, Cloud Run). Model endpoint locations are in the profile (ADR-013).
GOOGLE_CLOUD_LOCATION=europe-west6
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GPU_REGION=europe-west4

# --- Models: IDs live in agents/navigator/profiles/<name>.yaml (ADR-008) ---
NAV_PROFILE=default
# Optional per-run overrides of single profile fields (eval experiments):
# AGENT_MODEL=            AGENT_LOCATION=
# JUDGE_MODEL=            JUDGE_LOCATION=
# EMBEDDING_MODEL=        EMBEDDING_LOCATION=

# --- Services (filled after deploys) ---
# Local: `make mcp-dev`. Cloud Run (M2): https://swiss-nav-mcp-mdyqt5hgsq-oa.a.run.app/mcp
SWISS_LAW_MCP_URL=http://localhost:8080/mcp
AGENT_RUNTIME_ID=
APERTUS_BASE_URL=

# --- MCP server (mcp_server/server.py); defaults shown ---
# INDEX_PATH=data/index.sqlite
# SEARCH_MODE=            # dense (index default) | hybrid | bm25, for experiments
# SEARCH_RATE_PER_MIN=30  # search_law per client IP
# SEARCH_BURST=10
# LOG_JSON=0              # JSON logs (always on under Cloud Run)
# LOG_QUERIES=0           # 1 logs query text; off by default (questions can be personal)
# EMBEDDING_LOCATION=     # move the query-embedding endpoint; the model comes from the index

# --- Hugging Face (Apertus requires accepting its AUP) ---
HF_TOKEN=
