# Copy to .env (gitignored). See docs/GCP.md.

# --- GCP ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west6
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GPU_REGION=europe-west4

# --- Models (defaults; re-verify IDs in M0, see docs/AGENTS.md §6) ---
NAV_PROFILE=default            # agents/navigator/profiles/<name>.yaml
AGENT_MODEL=gemini-3.8-flash
JUDGE_MODEL=gemini-3.1-pro-preview
EMBEDDING_MODEL=gemini-embedding-2

# --- Services (filled after deploys) ---
SWISS_LAW_MCP_URL=http://localhost:8080/mcp
AGENT_RUNTIME_ID=
APERTUS_BASE_URL=

# --- Hugging Face (Apertus requires accepting its AUP) ---
HF_TOKEN=
