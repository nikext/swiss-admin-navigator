7-12-10" name="jolux:dateDocument"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRformat value="xml" fedlex:generator="2026-q2-rel-1.8.9"/></FRBRManifestation></identification><references source="#ch.bk"><TLCOrganization eId="ch.bk" href="https://fedlex.data.admin.ch/vocabulary/legal-institution/2" showAs="Bundeskanzlei"/><TLCRole eId="publisher" href="http://data.legilux.public.lu/resource/ontology/jolux#publisher" showAs="Editeur"/><TLCRole eId="rightsHolder" href="http://data.legilux.public.lu/resource/ontology/jolux#rightsHolder" showAs="Détenteur des droits"/><TLCReference name="language" href="http://publications.europa.eu/resource/authority/language/DEU" showAs="de"/><TLCReference name="format" href="https://fedlex.data.admin.ch/vocabulary/user-format/xml" showAs="xml"/></references></meta><preface><p><docNumber>210 </docNumber></p><p><docTitle>Schweizerisches Zivilgesetzbuch</docTitle></p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">vom 10. Dezember 1907 (Stand am 1. Juli 2026)</p></preface><body><title eId="tit_0"><num>Einleitung</num><level eId="tit_0/lvl_A" fedlex:role="marginal"><num>A. </num><heading>Anwendung des Rechts</heading><article eId="art_1"><num><b>Art. 1</b></num><paragraph eId="art_1/para_1"><num>1</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Das Gesetz findet auf alle Rechtsfragen Anwendung, für die es nach Wortlaut oder Auslegung eine Bestimmung enthält.</p></content></paragraph><paragraph eId="art_1/para_2"><num>2</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Kann dem Gesetz keine Vorschrift entnommen werden, so soll das Gericht<authorialNote>
		<p> Ausdruck gemäss Ziff. I 1 des BG vom 26. Juni 1998, in Kraft seit 1. Jan. 2000  (<ref href="https://fedlex.data.admin.ch/eli/oc/1999/149">AS <b>1999</b> 1118</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/1996/1_1_1_1">BBl <b>1996</b> I 1</ref>). Diese Änd. ist im ganzen Erlass berücksichtigt.</p>
	</authorialNote> nach Gewohnheitsrecht und, wo auch ein solches fehlt, nach der Regel entscheiden, die es als Gesetzgeber aufstellen würde.</p></content></paragraph><paragraph eId="art_1/para_3"><num>3</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Es folgt dabei bewährter Lehre und Überlieferung.</p></content></paragraph></article></level></title><proviso eId="disp_u1"><heading>Schlusstitel: <br/>Anwendungs- und Einführungsbestimmungen<inline name="man-font-weight-normal"><authorialNote>
		<p>  Fassung gemäss Ziff. I 4 des BG vom 26. Juni 1998, in Kraft seit 1. Jan. 2000  (<ref href="https://fedlex.data.admin.ch/eli/oc/1999/149">AS <b>1999</b> 1118</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/1996/1_1_1_1">BBl <b>1996</b> I 1</ref>).</p>
	</authorialNote></inline></heading><chapter eId="disp_u1/chap_1"><num>Erster Abschnitt:</num><heading>Die Anwendung bisherigen und neuen Rechts<inline name="man-font-weight-normal"><authorialNote>
		<p>  Fassung gemäss Ziff. I 4 des BG vom 26. Juni 1998, in Kraft seit 1. Jan. 2000  (<ref href="https://fedlex.data.admin.ch/eli/oc/1999/149">AS <b>1999</b> 1118</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/1996/1_1_1_1">BBl <b>1996</b> I 1</ref>).</p>
	</authorialNote></inline></heading><level eId="disp_u1/chap_1/lvl_B" fedlex:role="marginal"><num>B. </num><heading>Personenrecht</heading><level eId="disp_u1/chap_1/lvl_B/lvl_II_a" fedlex:role="marginal"><num>II<i>a</i>. </num><heading>Zentrale Datenbank im Zivilstandswesen</heading><article eId="disp_u1/art_6_a"><num><b>Art. 6</b><i>a</i><authorialNote>
		<p> Eingefügt durch Ziff. I des BG vom 5. Okt. 2001 (Elektronische Führung der Personenstandsregister), in Kraft seit 1. Juli 2004 (<ref href="https://fedlex.data.admin.ch/eli/oc/2004/361">AS <b>2004 </b>2911</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2001/407">BBl <b>2001</b> 1639</ref>).</p>
	</authorialNote></num><content><paragraph eId="disp_u1/art_6_a/para"><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><sup>1</sup> Der Bundesrat regelt den Übergang von der bisherigen auf die elektronische Registerführung.</p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><sup>2</sup> Der Bund übernimmt die Investitionskosten bis zu 5 Millionen Franken.</p></content></paragraph></content></article></level></level></chapter></proviso></body></act></akomaNtoso>